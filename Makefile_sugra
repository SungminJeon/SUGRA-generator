CXX = g++
CXXFLAGS = -std=c++17 -O2
COMMON_SRC = Tensor.C TopoLineCompact_enhanced.cpp Topology_enhanced.cpp

# Auto-detect Eigen path
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
    ifneq ($(wildcard /opt/homebrew/include/eigen3),)
        EIGEN_PATH ?= /opt/homebrew/include/eigen3
    else
        EIGEN_PATH ?= /usr/local/include/eigen3
    endif
else
    EIGEN_PATH ?= /usr/include/eigen3
endif

INCLUDES = -I. -I$(EIGEN_PATH)

all: gen_sugra_v2 gen_sugra_v5 gen_sugra_v6

gen_sugra_v2: gen_sugra_v2.cpp sugra_generator.h $(COMMON_SRC)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ gen_sugra_v2.cpp $(COMMON_SRC)

gen_sugra_v5: gen_sugra_v5.cpp sugra_generator.h $(COMMON_SRC)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ gen_sugra_v5.cpp $(COMMON_SRC)

gen_sugra_v6: gen_sugra_v6.cpp sugra_generator.h $(COMMON_SRC)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ gen_sugra_v6.cpp $(COMMON_SRC)

clean:
	rm -f gen_sugra_v2 gen_sugra_v5 gen_sugra_v6
